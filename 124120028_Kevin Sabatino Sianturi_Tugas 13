import streamlit as st
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.ndimage import uniform_filter
from scipy.interpolate import griddata, NearestNDInterpolator
import io

# Konfigurasi Halaman
st.set_page_config(page_title="Analisis Magnetic 2D", layout="wide")

# --- JUDUL & INTRO ---
st.title("Pengolahan Data Magnetic 2D")
st.markdown("""
Aplikasi ini melakukan pemisahan anomali **Regional** dan **Residual**.
Mendukung proses **Gridding** dari data acak (scatter) menjadi data grid teratur.
""")

# --- FUNGSI GENERATOR DATA (Untuk Dummy) ---
def get_dummy_dataframe(grid_size=50):
    x = np.linspace(0, 1000, grid_size)
    y = np.linspace(0, 1000, grid_size)
    X, Y = np.meshgrid(x, y)

    # Buat anomali
    regional = 0.05 * X + 0.02 * Y + 45000
    r = np.sqrt((X - 500)**2 + (Y - 500)**2 + 50**2)
    residual = 5000 * (50 / r)**3
    noise = np.random.normal(0, 1, (grid_size, grid_size))
    total = regional + residual + noise

    # Flatten & Random Sampling untuk simulasi data lapangan acak
    df = pd.DataFrame({
        'x': X.flatten(),
        'y': Y.flatten(),
        't_obs': total.flatten()
    })
    # Ambil sampel acak (misal 80% data) agar terlihat seperti data scatter
    return df.sample(frac=0.8).reset_index(drop=True)

# --- FUNGSI PENGOLAHAN UTAMA ---
def polyfit2d(x, y, z, order=1):
    x = x.flatten()
    y = y.flatten()
    z = z.flatten()
    
    # Filter NaN sebelum fitting (penting untuk data hasil interpolasi)
    mask = ~np.isnan(z)
    x, y, z = x[mask], y[mask], z[mask]
    
    if order == 1:
        A = np.c_[np.ones(x.shape), x, y]
    elif order == 2:
        A = np.c_[np.ones(x.shape), x, y, x**2, x*y, y**2]
    
    C, _, _, _ = np.linalg.lstsq(A, z, rcond=None)
    
    # Return fungsi lambda untuk menghitung nilai prediksi di sembarang titik
    if order == 1:
        return lambda xi, yi: C[0] + C[1]*xi + C[2]*yi
    elif order == 2:
        return lambda xi, yi: C[0] + C[1]*xi + C[2]*yi + C[3]*xi**2 + C[4]*xi*yi + C[5]*yi**2

# --- SIDEBAR: UPLOAD DATA ---
st.sidebar.header("Input Data")
uploaded_file = st.sidebar.file_uploader("Upload data CSV (kolom: x, y, t_obs)", type=['csv'])
use_dummy = st.sidebar.checkbox("Gunakan data dummy", value=True)

if uploaded_file is not None:
    df_input = pd.read_csv(uploaded_file)
elif use_dummy:
    df_input = get_dummy_dataframe(50)
else:
    st.info("Silakan upload file CSV atau centang 'Gunakan data dummy'")
    st.stop()

# --- PROSES GRIDDING (INTERPOLASI) ---
st.sidebar.markdown("---")
st.sidebar.subheader("Parameter Gridding")

# 1. Tentukan Batas Area
x_min, x_max = df_input['x'].min(), df_input['x'].max()
y_min, y_max = df_input['y'].min(), df_input['y'].max()

st.sidebar.text(f"Range X: {x_min:.1f} - {x_max:.1f} m")
st.sidebar.text(f"Range Y: {y_min:.1f} - {y_max:.1f} m")

# 2. Input Ukuran Sel (cell size)
default_cell = (x_max - x_min) / 50  # Default 50 grid points
cell_size = st.sidebar.number_input(
    "Ukuran Sel (meter)",
    min_value=1.0,
    max_value=(x_max - x_min)/5,
    value=float(default_cell),
    step=1.0,
    help="Semakin kecil nilai ini, resolusi peta semakin tinggi tapi komputasi lebih berat."
)

# 3. Metode Interpolasi
interp_method = st.sidebar.selectbox(
    "Metode Interpolasi",
    ['linear', 'cubic', 'nearest'],
    index=0,
    help="'linear' standard, 'cubic' lebih halus, 'nearest' kotak-kotak (pixelated)."
)

# 4. Resolusi Grid
x_grid = np.arange(x_min, x_max + cell_size, cell_size)
y_grid = np.arange(y_min, y_max + cell_size, cell_size)
X, Y = np.meshgrid(x_grid, y_grid)

with st.spinner("Melakukan interpolasi data..."):
    # Interpolasi data scatter ke grid
    T_obs_grid = griddata(
        (df_input['x'], df_input['y']),
        df_input['t_obs'],
        (X, Y),
        method=interp_method
    )

# --- VISUALISASI HASIL GRIDDING ---
st.subheader("1. Visualisasi Data")
tab1, tab2 = st.tabs(['Peta Kontur (Gridded)', "Sebaran Titik Data (Scatter)"])

with tab1:
    col_a, col_b = st.columns([3, 1])
    with col_a:
        fig1, ax1 = plt.subplots(figsize=(10, 6))
        c1 = ax1.contourf(X, Y, T_obs_grid, levels=25, cmap='jet')
        ax1.scatter(df_input['x'], df_input['y'], c='k', s=5, alpha=0.2, label='Observed Point')
        ax1.set_title(f"Total Magnetic Intensity (Grid Spacing: {cell_size:.1f} m)")
        ax1.set_xlabel('Easting (x)')
        ax1.set_ylabel('Northing (y)')
        ax1.legend(loc='upper right')
        ax1.set_aspect('equal')
        fig1.colorbar(c1, ax=ax1, label='nT')
        st.pyplot(fig1)
    with col_b:
        st.info("""
        **Keterangan:**
        - Warna menunjukkan intensitas magnetik.
        - Titik hitam adalah lokasi pengukuran.
        - Area putih menunjukkan tidak ada data di sekitar titik tersebut (No Data Value).
        """)

with tab2:
    fig_scatter, ax_s = plt.subplots(figsize=(8, 6))
    c2 = ax_s.scatter(df_input['x'], df_input['y'], c=df_input['t_obs'], cmap='jet', s=10)
    ax_s.set_title("Posisi Titik Pengukuran Asli")
    ax_s.set_xlabel('Easting (x)')
    ax_s.set_ylabel('Northing (y)')
    fig_scatter.colorbar(c2, ax=ax_s, label='nT')
    st.pyplot(fig_scatter)

st.divider()

# --- PENGOLAHAN (REGIONAL - RESIDUAL) ---
st.subheader("2. Pemisahan Regional-Residual")

# Isi NaN dengan nearest value agar filter tidak rusak
mask_nan = np.isnan(T_obs_grid)
if np.any(mask_nan):
    mask_valid = ~mask_nan
    xx_valid, yy_valid = X[mask_valid], Y[mask_valid]
    zz_valid = T_obs_grid[mask_valid]
    interp_nn = NearestNDInterpolator(list(zip(xx_valid, yy_valid)), zz_valid)
    T_filled = interp_nn(X, Y)
else:
    T_filled = T_obs_grid

# --- CHALLENGE IMPLEMENTATION ---
st.sidebar.markdown("---")
st.sidebar.subheader("Pengaturan Visualisasi")

# 1. Pilihan Colormap
cmap_options = ['jet', 'viridis', 'plasma', 'inferno', 'magma', 'coolwarm', 'seismic', 'rainbow']
selected_cmap = st.sidebar.selectbox("Pilih Colormap", cmap_options, index=0)

# 2. Kontrol Vmin dan Vmax
scale_mode = st.sidebar.radio("Mode Skala", ["Auto", "Manual"])
if scale_mode == "Manual":
    vmin = st.sidebar.slider("Nilai Minimum (vmin)", -50000, 50000, -20000)
    vmax = st.sidebar.slider("Nilai Maksimum (vmax)", -50000, 50000, 50000)
else:
    vmin = None
    vmax = None

# Metode Pemisahan
method = st.selectbox("Metode Pemisahan:", ["2D Moving Average", "Trend Surface Analysis"])
Calculated_Regional = np.zeros_like(T_obs_grid)

if method == "2D Moving Average":
    window_pts = st.slider("Ukuran Window (Grid Points)", 3, 50, 9, step=2)
    st.caption(f"Ukuran fisik window = {window_pts * cell_size:.1f} meter")
    Calculated_Regional = uniform_filter(T_filled, size=window_pts, mode='nearest')

elif method == "Trend Surface Analysis":
    poly_order = st.radio("Orde Polinomial:", [1, 2], horizontal=True)
    poly_func = polyfit2d(X, Y, T_obs_grid, order=poly_order)
    Calculated_Regional = poly_func(X, Y)

Calculated_Residual = T_obs_grid - Calculated_Regional

# --- TAMPILAN HASIL ---
st.subheader("3. Hasil Pemisahan")
col_reg, col_res = st.columns(2)

with col_reg:
    st.markdown("### Regional (Trend)")
    fig2, ax2 = plt.subplots(figsize=(6, 5))
    c3 = ax2.contourf(X, Y, Calculated_Regional, levels=20, cmap=selected_cmap, vmin=vmin, vmax=vmax)
    ax2.set_title("Anomali Regional")
    ax2.set_xlabel('Easting (x)')
    ax2.set_ylabel('Northing (y)')
    ax2.set_aspect('equal')
    fig2.colorbar(c3, ax=ax2, label='nT')
    st.pyplot(fig2)

with col_res:
    st.markdown("### Residual (Anomali Target)")
    fig3, ax3 = plt.subplots(figsize=(6, 5))
    # Hitung limit untuk residual mengabaikan NaN
    valid_res = Calculated_Residual[~np.isnan(Calculated_Residual)]
    if len(valid_res) > 0:
        limit = np.percentile(np.abs(valid_res), 98)
    else:
        limit = 100
    
    c4 = ax3.contourf(X, Y, Calculated_Residual, levels=20, cmap='seismic', 
                      vmin=-limit if vmin is None else vmin, 
                      vmax=limit if vmax is None else vmax)
    ax3.set_title("Anomali Residual")
    ax3.set_xlabel('Easting (x)')
    ax3.set_ylabel('Northing (y)')
    ax3.set_aspect('equal')
    fig3.colorbar(c4, ax=ax3, label='nT')
    st.pyplot(fig3)

# --- OPSI TAMBAHAN (CHALLENGE) ---
st.sidebar.markdown("---")
st.sidebar.subheader("Opsi Tambahan")

# Opsi menyimpan plot
if st.sidebar.button("Simpan Plot Sebagai Gambar"):
    buf = io.BytesIO()
    fig2.savefig(buf, format="png", dpi=150)
    st.sidebar.download_button(
        label="Download Regional Plot",
        data=buf,
        file_name="regional_anomaly.png",
        mime="image/png"
    )
    
    buf2 = io.BytesIO()
    fig3.savefig(buf2, format="png", dpi=150)
    st.sidebar.download_button(
        label="Download Residual Plot",
        data=buf2,
        file_name="residual_anomaly.png",
        mime="image/png"
    )

st.success("Analisis selesai! Gunakan sidebar untuk menyesuaikan parameter.")
